{
  "info": {
    "name": "Shop Stream App (Event Collaboration)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "End-to-end сценарий ДЗ: регистрация → deposit → заказ (успех и неуспех) → проверка баланса и уведомлений. Использует {{baseUrl}} = http://arch.homework и polling для асинхронных событий Kafka."
  },
  "item": [
    {
      "name": "01. Register user",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const rnd = Math.random().toString(36).substring(2, 10);",
              "pm.collectionVariables.set('email', `user_${rnd}@example.com`);",
              "pm.collectionVariables.set('password', 'password123');",
              "pm.collectionVariables.set('name', `User ${rnd}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('=== REQUEST ===');",
              "console.log(pm.request.method, pm.request.url.toString());",
              "if (pm.request.body && pm.request.body.raw) console.log('BODY:', pm.request.body.raw);",
              "console.log('=== RESPONSE ===');",
              "console.log('STATUS:', pm.response.code);",
              "console.log('BODY:', pm.response.text());",
              "",
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('Has id and token', () => {",
              "  pm.expect(j.id).to.be.a('number');",
              "  pm.expect(j.token).to.be.a('string');",
              "});",
              "pm.collectionVariables.set('userId', j.id);",
              "pm.collectionVariables.set('token', j.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02. Poll account creation",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('=== REQUEST ===');",
              "console.log(pm.request.method, pm.request.url.toString());",
              "console.log('=== RESPONSE ===');",
              "console.log('STATUS:', pm.response.code);",
              "console.log('BODY:', pm.response.text());",
              "",
              "const attempt = +(pm.collectionVariables.get('accountPollAttempt') || 0);",
              "const status = pm.response.code;",
              "if (status === 500 || status === 404) {",
              "  if (attempt < 10) {",
              "    pm.collectionVariables.set('accountPollAttempt', attempt + 1);",
              "    console.log('Account not ready yet, retrying in 500ms... attempt=' + (attempt+1));",
              "    postman.setNextRequest('02. Poll account creation');",
              "  } else {",
              "    pm.test('Account created within 5s', () => { throw new Error('Account not created'); });",
              "  }",
              "} else {",
              "  pm.collectionVariables.set('accountPollAttempt', 0);",
              "  pm.test('Status 200', () => pm.response.to.have.status(200));",
              "  const j = pm.response.json();",
              "  pm.test('Balance is 0', () => pm.expect(+j.balance).to.eql(0));",
              "  pm.collectionVariables.set('accountId', j.accountId);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/billing/accounts/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "billing",
            "accounts",
            "me"
          ]
        }
      },
      "response": []
    },
    {
      "name": "03. Deposit 1000",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('=== REQUEST ===');",
              "console.log(pm.request.method, pm.request.url.toString());",
              "if (pm.request.body && pm.request.body.raw) console.log('BODY:', pm.request.body.raw);",
              "console.log('=== RESPONSE ===');",
              "console.log('STATUS:', pm.response.code);",
              "console.log('BODY:', pm.response.text());",
              "",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('Balance = 1000', () => pm.expect(+j.balance).to.eql(1000));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 1000\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/billing/accounts/me/deposit",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "billing",
            "accounts",
            "me",
            "deposit"
          ]
        }
      },
      "response": []
    },
    {
      "name": "04. Create order 300",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('=== REQUEST ===');",
              "console.log(pm.request.method, pm.request.url.toString());",
