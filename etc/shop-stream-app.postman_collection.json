          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        }
      },
      "response": []
    },
    {
      "name": "05. Poll order1 until PAID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('=== REQUEST ===');",
              "console.log(pm.request.method, pm.request.url.toString());",
              "console.log('=== RESPONSE ===');",
              "console.log('STATUS:', pm.response.code);",
              "console.log('BODY:', pm.response.text());",
              "",
              "const attempt = +(pm.collectionVariables.get('order1PollAttempt') || 0);",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "if (j.status === 'NEW' && attempt < 20) {",
              "  pm.collectionVariables.set('order1PollAttempt', attempt + 1);",
              "  console.log('Still NEW, retrying... attempt=' + (attempt+1));",
              "  postman.setNextRequest('05. Poll order1 until PAID');",
              "} else {",
              "  pm.collectionVariables.set('order1PollAttempt', 0);",
              "  pm.test('Order1 PAID', () => pm.expect(j.status).to.eql('PAID'));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders/{{order1Id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders",
            "{{order1Id}}"
          ]
        }
      },
      "response": []
    },
