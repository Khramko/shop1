    {
      "name": "07. Poll notifications for HAPPY",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('=== REQUEST ===');",
              "console.log(pm.request.method, pm.request.url.toString());",
              "console.log('=== RESPONSE ===');",
              "console.log('STATUS:', pm.response.code);",
              "console.log('BODY:', pm.response.text());",
              "",
              "const attempt = +(pm.collectionVariables.get('notif1PollAttempt') || 0);",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const arr = pm.response.json();",
              "const happy = arr.find(n => n.type === 'HAPPY' && n.orderId == pm.collectionVariables.get('order1Id'));",
              "if (!happy && attempt < 20) {",
              "  pm.collectionVariables.set('notif1PollAttempt', attempt + 1);",
              "  console.log('HAPPY not found, retrying... attempt=' + (attempt+1));",
              "  postman.setNextRequest('07. Poll notifications for HAPPY');",
              "} else {",
              "  pm.collectionVariables.set('notif1PollAttempt', 0);",
              "  pm.test('HAPPY notification exists for order1', () => pm.expect(happy).to.exist);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/notifications",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "notifications"
          ]
        }
      },
      "response": []
    },
